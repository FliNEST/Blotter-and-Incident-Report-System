# ── SERVER ──────────────────────────────
PORT=3000

# ── DATABASE (MySQL) ─────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=blotter_db

# ── JWT ──────────────────────────────────
JWT_SECRET=blotter_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h

# ── FILE UPLOAD ──────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ── CLIENT URL (for CORS) ────────────────
CLIENT_URL=http://localhost:5500
